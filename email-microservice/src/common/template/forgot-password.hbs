
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset OTP - {{companyName}}</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f6f9; font-family:Arial, Helvetica, sans-serif; color:#202124;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color:#f4f6f9; padding:40px 15px;">

        <tr>
            <td align="center">

                <table width="600" cellpadding="0" cellspacing="0" border="0"
                    style="max-width:600px; width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center"
                            style="background-color:#111827; padding:35px 25px;">

                            <h1 style="margin:0; color:#ffffff; font-size:27px;">
                                {{companyName}}
                            </h1>

                            <p style="margin:10px 0 0; color:#cbd5e1; font-size:13px; letter-spacing:1px;">
                                ACCOUNT SECURITY
                            </p>

                        </td>
                    </tr>

                    <!-- Main Content -->
                    <tr>
                        <td style="padding:40px 35px;">

                            <h2 style="margin:0 0 18px; font-size:25px; color:#111827;">
                                Password Reset Request
                            </h2>

                            <p style="margin:0 0 18px; font-size:15px; line-height:1.8; color:#4b5563;">
                                We received a request to reset the password
                                associated with your account.
                            </p>

                            <p style="margin:0 0 25px; font-size:15px; line-height:1.8; color:#4b5563;">
                                Use the following One-Time Password (OTP)
                                to verify your identity.
                            </p>

                            <!-- OTP Card -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="background-color:#f8fafc; border:1px solid #e5e7eb; border-radius:10px;">

                                <tr>
                                    <td align="center" style="padding:30px 20px;">

                                        <p style="margin:0 0 15px; color:#64748b; font-size:12px; font-weight:700; letter-spacing:1.5px;">
                                            YOUR VERIFICATION CODE
                                        </p>

                                        <h1 style="margin:0; color:#111827; font-size:36px; letter-spacing:10px; font-weight:700;">
                                            {{resetCode}}
                                        </h1>

                                        <p style="margin:15px 0 0; color:#64748b; font-size:13px;">
                                            Enter this code on the password reset page.
                                        </p>

                                    </td>
                                </tr>

                            </table>

                            <!-- Expiry -->
                            <p style="margin:25px 0 10px; font-size:14px; line-height:1.7; color:#dc2626;">
                                This OTP is valid for only 5 minutes.
                            </p>

                            <p style="margin:15px 0 0; font-size:14px; line-height:1.7; color:#4b5563;">
                                If you did not request a password reset,
                                please ignore this email. Your password
                                will remain unchanged.
                            </p>

                            <p style="margin:25px 0 0; font-size:14px; color:#374151;">
                                Best regards,<br>
                                <strong>{{companyName}} Team</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="background-color:#f8fafc; padding:25px 20px; border-top:1px solid #e5e7eb;">

                            <p style="margin:0 0 10px; color:#64748b; font-size:12px;">
                                © {{year}} {{companyName}}. All rights reserved.
                            </p>

                            <p style="margin:0; color:#94a3b8; font-size:11px;">
                                This is an automated security email.
                                Please do not reply.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>
</html>
