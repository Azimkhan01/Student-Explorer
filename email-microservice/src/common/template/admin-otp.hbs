
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login Verification</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f5f7; font-family: Arial, Helvetica, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color: #f4f5f7; padding: 40px 15px;">

    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width: 480px; background-color: #ffffff; border-radius: 12px; overflow: hidden;">

          <!-- Header -->
          <tr>
            <td align="center"
              style="background-color: #111827; padding: 30px 20px;">

              <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 700;">
                {{companyName}}
              </h1>

              <p style="margin: 10px 0 0; color: #9ca3af; font-size: 13px;">
                ADMIN PORTAL
              </p>

            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td align="center" style="padding: 40px 30px 30px;">

              <h2 style="margin: 0 0 12px; color: #111827; font-size: 22px;">
                Login Verification
              </h2>

              <p style="margin: 0 0 30px; color: #6b7280; font-size: 14px; line-height: 1.6;">
                Use the verification code below to securely access your admin account.
              </p>

              <!-- OTP -->
              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center"
                    style="background-color: #f3f4f6; border: 1px dashed #9ca3af; border-radius: 8px; padding: 18px 35px;">

                    <span style="color: #111827; font-size: 32px; font-weight: 700; letter-spacing: 10px;">
                      {{otp}}
                    </span>

                  </td>
                </tr>
              </table>

              <p style="margin: 25px 0 0; color: #6b7280; font-size: 13px; line-height: 1.6;">
                This code is valid for a limited time. Please do not share it with anyone.
              </p>

            </td>
          </tr>

          <!-- Security Notice -->
          <tr>
            <td style="padding: 20px 30px; background-color: #f9fafb;">

              <p style="margin: 0; color: #9ca3af; font-size: 12px; line-height: 1.6; text-align: center;">
                If you did not request this login verification, please ignore this email.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding: 20px;">

              <p style="margin: 0; color: #9ca3af; font-size: 11px;">
                &copy; {{companyName}}. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>

  </table>

</body>
</html>
